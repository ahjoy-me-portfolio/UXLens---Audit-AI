rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() == 'ahjoy.me@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && 'email' in request.auth.token && request.auth.token.email.lower() == 'ahjoy.me@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500000)) &&
             (!('role' in data) || data.role is string) &&
             (!('languagePreference' in data) || data.languagePreference is string) &&
             (!('darkMode' in data) || data.darkMode is bool) &&
             (!('notifications' in data) || data.notifications is bool) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 500)) &&
             (!('jobTitle' in data) || data.jobTitle == null || (data.jobTitle is string && data.jobTitle.size() <= 100));
    }

    // --- Rules ---

    // Admins Collection: Used for RBAC
    // Normally should be locked down, but for initial setup we might need to seed it.
    // However, the agent instructions say to include the user email from runtime as an admin.
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
                      'fullName' in incoming() && incoming().fullName != null &&
                      'createdAt' in incoming() && incoming().createdAt != null &&
                      isValidUser(incoming());
      allow update: if isOwner(userId) &&
                      // Ensure immutable or RBAC fields are not changed
                      (!('role' in incoming()) || !('role' in existing()) || incoming().role == existing().role) &&
                      (!('email' in incoming()) || !('email' in existing()) || incoming().email == existing().email) &&
                      (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                      (!('subscriptionPlan' in incoming()) || !('subscriptionPlan' in existing()) || incoming().subscriptionPlan == existing().subscriptionPlan) &&
                      // Allow changes only to user-modifiable fields
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'fullName', 'avatarUrl', 'jobTitle', 'bio', 
                        'darkMode', 'notifications', 'languagePreference', 'updatedAt',
                        'role', 'email', 'createdAt', 'subscriptionPlan'
                      ]) &&
                      isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // App Configuration (Public Read, Admin Write)
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Security Configuration (Admin ONLY)
    match /security/config {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Analysis Reports
    match /reports/{reportId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                      incoming().userId == request.auth.uid;
      allow update: if isSignedIn() &&
                      existing().userId == request.auth.uid &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['isFavorite']) &&
                      incoming().userId == existing().userId; // Protect ownership
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
